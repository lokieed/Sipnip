# Copy this to contracts/.env (never commit the real .env)

# The deployed escrow package (already deployed - see DEPLOYMENT.md)
SUI_PACKAGE_ID=0xa1cb6dc073981bb0d28aa2281afa3d434295666972a60b5410e49a005acf08a6

# The shared wallet used for the demo
SUI_WALLET_ADDRESS=0x5a74b232069d7114400321fb89116192f219a32d3849f233928157aac5afc7b3

# That wallet's private key, used to sign every transaction this server sends.
# Get it with: sui keytool export --key-identity <alias-or-address>
# Looks like: suiprivkey1qxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# NEVER commit the real value - .env is already gitignored at the repo root.
SUI_PRIVATE_KEY=
